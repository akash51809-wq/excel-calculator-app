<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Excel Report - Daybook App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { min-height: 100vh; background: #343a40; color: #fff; }
        .sidebar a { color: #cfd2d6; text-decoration: none; padding: 12px 20px; display: block; transition: 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: #0d6efd; color: #fff; border-radius: 5px; }
        .card { border: none; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 d-md-block sidebar collapse p-3">
                <h4 class="text-center text-white py-3"><i class="fa-solid fa-calculator"></i> Daybook App</h4>
                <hr class="text-secondary">
                <ul class="nav flex-column">
                    <li class="nav-item mb-2"><a href="/dashboard"><i class="fa-solid fa-chart-line me-2"></i> Dashboard</a></li>
                    <li class="nav-item mb-2"><a href="/upload"><i class="fa-solid fa-file-arrow-up me-2"></i> Upload Excel</a></li>
                    <li class="nav-item mb-2">
                        <a href="#reportsSubmenu" data-bs-toggle="collapse" class="d-flex justify-content-between align-items-center active">
                            <span><i class="fa-solid fa-table-list me-2"></i> Reports</span>
                            <i class="fa-solid fa-chevron-down small"></i>
                        </a>
                        <ul class="collapse show list-unstyled ps-3 mt-1" id="reportsSubmenu">
                            <li class="nav-item mb-1"><a href="/reports/upload-report" class="py-2 small active"><i class="fa-solid fa-file-excel me-2"></i> Upload Excel Report</a></li>
                            <li class="nav-item mb-1"><a href="/reports/dealer-list" class="py-2 small"><i class="fa-solid fa-users me-2"></i> Show Dealer List</a></li>
                        </ul>
                    </li>
                    <li class="nav-item mb-2"><a href="/settings"><i class="fa-solid fa-gear me-2"></i> Settings</a></li>
                    <li class="nav-item mt-4"><a href="/api/logout" class="text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a></li>
                </ul>
            </div>
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2"><i class="fa-solid fa-file-excel text-primary me-2"></i> Uploaded Excel Reports History</h1>
                </div>
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Date</th>
                                        <th>File Name</th>
                                        <th>Total Purchase</th>
                                        <th>Total Sale</th>
                                        <th>Opening Balance</th>
                                        <th>Closing Balance</th>
                                    </tr>
                                </thead>
                                <tbody id="reportTableBody">
                                    <tr><td colspan="6" class="text-center py-4">Loading reports...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function loadReports() {
            try {
                const res = await fetch('/api/excel/reports');
                const result = await res.json();
                const tbody = document.getElementById('reportTableBody');
                if (result.success && result.reports.length > 0) {
                    tbody.innerHTML = result.reports.map(rep => `
                        <tr>
                            <td><strong>${rep.recordDate}</strong></td>
                            <td>${rep.fileName || 'N/A'}</td>
                            <td class="text-success fw-bold">₹${(rep.totalPurchase || 0).toLocaleString('en-IN')}</td>
                            <td class="text-danger fw-bold">₹${(rep.totalSale || 0).toLocaleString('en-IN')}</td>
                            <td>₹${(rep.openingBalance || 0).toLocaleString('en-IN')}</td>
                            <td class="fw-bold">₹${(rep.closingBalance || 0).toLocaleString('en-IN')}</td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">No reports found.</td></tr>`;
                }
            } catch (err) { console.error(err); }
        }
        document.addEventListener('DOMContentLoaded', loadReports);
    </script>
</body>
</html>