<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealer List & Lapu Numbers - Daybook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { min-height: 100vh; background: #343a40; color: #fff; }
        .sidebar a { color: #cfd2d6; text-decoration: none; padding: 12px 20px; display: block; transition: 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: #0d6efd; color: #fff; border-radius: 5px; }
        .card { border: none; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 d-md-block sidebar collapse p-3">
                <h4 class="text-center text-white py-3"><i class="fa-solid fa-calculator"></i> Daybook App</h4>
                <hr class="text-secondary">
                <ul class="nav flex-column">
                    <li class="nav-item mb-2"><a href="/dashboard"><i class="fa-solid fa-chart-line me-2"></i> Dashboard</a></li>
                    <li class="nav-item mb-2"><a href="/upload"><i class="fa-solid fa-file-arrow-up me-2"></i> Upload Excel</a></li>
                    <li class="nav-item mb-2">
                        <a href="#reportsSubmenu" data-bs-toggle="collapse" class="d-flex justify-content-between align-items-center active">
                            <span><i class="fa-solid fa-table-list me-2"></i> Reports</span>
                            <i class="fa-solid fa-chevron-down small"></i>
                        </a>
                        <ul class="collapse show list-unstyled ps-3 mt-1" id="reportsSubmenu">
                            <li class="nav-item mb-1"><a href="/reports/upload-report" class="py-2 small"><i class="fa-solid fa-file-excel me-2"></i> Upload Excel Report</a></li>
                            <li class="nav-item mb-1"><a href="/reports/dealer-list" class="py-2 small active"><i class="fa-solid fa-users me-2"></i> Show Dealer List</a></li>
                        </ul>
                    </li>
                    <li class="nav-item mb-2"><a href="/settings"><i class="fa-solid fa-gear me-2"></i> Settings</a></li>
                    <li class="nav-item mt-4"><a href="/api/logout" class="text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a></li>
                </ul>
            </div>
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2"><i class="fa-solid fa-users text-primary me-2"></i> Unique Dealer List & Lapu Numbers</h1>
                </div>
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-dark">
                                    <tr><th>ID</th><th>DEALER DETAILS</th><th>TOTAL LAPU COUNT</th><th>STATUS</th><th class="text-center">ACTION / LAPU</th></tr>
                                </thead>
                                <tbody id="dealerTableBody"><tr><td colspan="5" class="text-center py-4">Loading dealers from excel sheets...</td></tr></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <div class="modal fade" id="lapuModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fa-solid fa-sim-card me-2"></i> Lapu Numbers for <span id="modalDealerName"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="lapuSelectDropdown" class="form-label fw-bold text-secondary">Select / View Associated Lapu Numbers:</label>
                        <select id="lapuSelectDropdown" class="form-select"></select>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let globalDealersData = [];
        async function fetchDealers() {
            try {
                const res = await fetch('/api/excel/dealers-list');
                const result = await res.json();
                if (result.success) {
                    globalDealersData = result.dealers;
                    renderDealerTable(globalDealersData);
                }
            } catch (err) { console.error(err); }
        }
        function renderDealerTable(dealers) {
            const tbody = document.getElementById('dealerTableBody');
            if (dealers.length === 0) { tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">No dealers found in uploaded excel sheets.</td></tr>`; return; }
            tbody.innerHTML = dealers.map((dealer, index) => `
                <tr>
                    <td><strong>#${dealer.id}</strong></td>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-secondary text-white d-flex justify-content-center align-items-center me-3" style="width: 45px; height: 45px; font-weight: bold;">
                                ${dealer.dealerName.charAt(0).toUpperCase()}
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">${dealer.dealerName}</h6>
                                <small class="text-muted">Excel Extracted Dealer</small>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge bg-info text-dark">${dealer.lapuNumbers.length} Lapu Found</span></td>
                    <td><span class="badge bg-success">Active</span></td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-primary fw-bold px-3" onclick="openLapuModal('${dealer.dealerName}')">
                            <i class="fa-solid fa-sim-card me-1"></i> Show Lapu
                        </button>
                    </td>
                </tr>
            `).join('');
        }
        function openLapuModal(dealerName) {
            const dealer = globalDealersData.find(d => d.dealerName === dealerName);
            if (!dealer) return;
            document.getElementById('modalDealerName').innerText = dealer.dealerName;
            const dropdown = document.getElementById('lapuSelectDropdown');
            if (dealer.lapuNumbers.length === 0) {
                dropdown.innerHTML = `<option value="">No Lapu numbers available for this dealer</option>`;
            } else {
                dropdown.innerHTML = dealer.lapuNumbers.map(num => `<option value="${num}">${num}</option>`).join('');
            }
            new bootstrap.Modal(document.getElementById('lapuModal')).show();
        }
        document.addEventListener('DOMContentLoaded', fetchDealers);
    </script>
</body>
</html>