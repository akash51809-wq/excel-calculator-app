<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Daybook App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { min-height: 100vh; background: #343a40; color: #fff; }
        .sidebar a { color: #cfd2d6; text-decoration: none; padding: 12px 20px; display: block; transition: 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: #0d6efd; color: #fff; border-radius: 5px; }
        .card { border: none; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 d-md-block sidebar collapse p-3">
                <h4 class="text-center text-white py-3"><i class="fa-solid fa-calculator"></i> Daybook App</h4>
                <hr class="text-secondary">
                <ul class="nav flex-column">
                    <li class="nav-item mb-2"><a href="/dashboard" class="active"><i class="fa-solid fa-chart-line me-2"></i> Dashboard</a></li>
                    <li class="nav-item mb-2"><a href="/upload"><i class="fa-solid fa-file-arrow-up me-2"></i> Upload Excel</a></li>
                    <li class="nav-item mb-2">
                        <a href="#reportsSubmenu" data-bs-toggle="collapse" class="d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-table-list me-2"></i> Reports</span>
                            <i class="fa-solid fa-chevron-down small"></i>
                        </a>
                        <ul class="collapse list-unstyled ps-3 mt-1" id="reportsSubmenu">
                            <li class="nav-item mb-1"><a href="/reports/upload-report" class="py-2 small"><i class="fa-solid fa-file-excel me-2"></i> Upload Excel Report</a></li>
                            <li class="nav-item mb-1"><a href="/reports/dealer-list" class="py-2 small"><i class="fa-solid fa-users me-2"></i> Show Dealer List</a></li>
                        </ul>
                    </li>
                    <li class="nav-item mb-2"><a href="/settings"><i class="fa-solid fa-gear me-2"></i> Settings</a></li>
                    <li class="nav-item mt-4"><a href="/api/logout" class="text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a></li>
                </ul>
            </div>
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2"><i class="fa-solid fa-chart-line text-primary me-2"></i> Analytics & Overview</h1>
                    <a href="/upload" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Upload New Sheet</a>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card bg-white p-3 border-start border-primary border-4">
                            <span class="text-muted small fw-bold">TOTAL REPORTS</span>
                            <h3 class="fw-bold mt-1 text-dark" id="totalReportsCount">0</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-white p-3 border-start border-success border-4">
                            <span class="text-muted small fw-bold">TOTAL PURCHASE</span>
                            <h3 class="fw-bold mt-1 text-success" id="totalPurchaseSum">₹0</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-white p-3 border-start border-danger border-4">
                            <span class="text-muted small fw-bold">TOTAL SALE</span>
                            <h3 class="fw-bold mt-1 text-danger" id="totalSaleSum">₹0</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-white p-3 border-start border-warning border-4">
                            <span class="text-muted small fw-bold">NET DIFFERENCE</span>
                            <h3 class="fw-bold mt-1 text-dark" id="netDiffSum">₹0</h3>
                        </div>
                    </div>
                </div>
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white"><h5 class="mb-0"><i class="fa-solid fa-clock-rotate-left me-2"></i> Recent File Operations</h5></div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-secondary">
                                    <tr><th>Date</th><th>File Name</th><th>Purchase</th><th>Sale</th><th>Closing Balance</th></tr>
                                </thead>
                                <tbody id="recentTableBody"><tr><td colspan="5" class="text-center py-3">Loading summary...</td></tr></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function loadDashboardData() {
            try {
                const res = await fetch('/api/excel/reports');
                const result = await res.json();
                if (result.success) {
                    const reports = result.reports;
                    document.getElementById('totalReportsCount').innerText = reports.length;
                    let totalP = 0, totalS = 0;
                    reports.forEach(r => { totalP += (r.totalPurchase || 0); totalS += (r.totalSale || 0); });
                    document.getElementById('totalPurchaseSum').innerText = `₹${totalP.toLocaleString('en-IN')}`;
                    document.getElementById('totalSaleSum').innerText = `₹${totalS.toLocaleString('en-IN')}`;
                    document.getElementById('netDiffSum').innerText = `₹${(totalP - totalS).toLocaleString('en-IN')}`;
                    const tbody = document.getElementById('recentTableBody');
                    if (reports.length === 0) { tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-3">No recent records found.</td></tr>`; return; }
                    tbody.innerHTML = reports.slice(0, 5).map(rep => `
                        <tr>
                            <td><strong>${rep.recordDate}</strong></td>
                            <td>${rep.fileName || 'N/A'}</td>
                            <td class="text-success fw-bold">₹${(rep.totalPurchase || 0).toLocaleString('en-IN')}</td>
                            <td class="text-danger fw-bold">₹${(rep.totalSale || 0).toLocaleString('en-IN')}</td>
                            <td class="fw-bold">₹${(rep.closingBalance || 0).toLocaleString('en-IN')}</td>
                        </tr>
                    `).join('');
                }
            } catch (err) { console.error(err); }
        }
        document.addEventListener('DOMContentLoaded', loadDashboardData);
    </script>
</body>
</html>